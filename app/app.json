{
  "expo": {
    "name": "Housie Tambola King",
    "slug": "housie-tambola-king",
    "scheme": "housietambolaking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1E0B3B",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.housietambolaking.app",
      "infoPlist": {}
    },
    "android": {
      "package": "com.housietambolaking.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4C1D95",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E0B3B"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7C3AED",
          "icon": "./assets/android-icon-monochrome.png"
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-status-bar"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "url": "https://u.expo.dev/029428f2-fcac-4e06-abd2-f27f3731a9ed"
    },
    "extra": {
      "eas": {
        "projectId": "029428f2-fcac-4e06-abd2-f27f3731a9ed"
      }
    },
    "owner": "projectblurimedia"
  }
}
