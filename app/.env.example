# Copy to app/.env (gitignored). EXPO_PUBLIC_* values are bundled into the app — only
# public keys go here (the Supabase anon key is public by design; RLS protects data).
# Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
